{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarangsho-plus.local/contracts/client-edition/v1/schema.json",
  "title": "Sarangsho Plus client edition projection",
  "description": "Engine-owned read-only Android delivery projection v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "content_hash", "edition", "stories"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "edition_key", "status", "published_at", "languages"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 160},
        "edition_key": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([_-][a-z0-9-]+)?$"},
        "status": {"const": "published"},
        "published_at": {"type": "string", "format": "date-time"},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}},
        "supersedes_edition_id": {"type": "string", "minLength": 3, "maxLength": 160},
        "correction_note": {"type": "string", "maxLength": 4000}
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "published_at", "source", "summaries"],
        "properties": {
          "id": {"type": "string", "minLength": 3, "maxLength": 160},
          "title": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 1000}},
          "topic_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
          "published_at": {"type": "string", "format": "date-time"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "url", "published_at"],
            "properties": {
              "id": {"type": "string", "minLength": 3, "maxLength": 160},
              "name": {"type": "string", "minLength": 1, "maxLength": 300},
              "url": {"type": "string", "format": "uri"},
              "published_at": {"type": "string", "format": "date-time"}
            }
          },
          "correction": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["note", "corrected_at"],
            "properties": {
              "note": {"type": "string", "minLength": 1, "maxLength": 4000},
              "corrected_at": {"type": "string", "format": "date-time"}
            }
          },
          "summaries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["language", "status", "brief", "detailed"],
              "properties": {
                "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
                "status": {"const": "approved"},
                "brief": {"type": "string", "minLength": 1, "maxLength": 2000},
                "detailed": {"type": "string", "minLength": 1, "maxLength": 12000}
              }
            }
          }
        }
      }
    }
  }
}

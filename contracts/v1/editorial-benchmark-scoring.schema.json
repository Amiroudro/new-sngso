{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarangsho.example/contracts/v1/editorial-benchmark-scoring.schema.json",
  "title": "Criterion-level editorial benchmark scoring record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_fingerprint",
    "item_id",
    "task_type",
    "language",
    "evaluator_id",
    "evaluated_at",
    "scale",
    "criterion_scores"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "benchmark_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "task_type": {
      "enum": [
        "headline",
        "summary",
        "translation",
        "claim_extraction",
        "fact_check",
        "vocabulary",
        "editorial_judgment"
      ]
    },
    "language": {
      "enum": [
        "bn",
        "en"
      ]
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "const": 0
        },
        "maximum": {
          "const": 4
        }
      }
    },
    "criterion_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "weight",
          "score",
          "anchor",
          "rationale",
          "evidence_references"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "anchor": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 3000
          },
          "evidence_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "critical_failure": {
      "type": "boolean",
      "default": false
    },
    "critical_failure_reason": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "critical_failure": {
            "const": true
          }
        },
        "required": [
          "critical_failure"
        ]
      },
      "then": {
        "required": [
          "critical_failure_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "critical_failure_reason": {
            "type": "string"
          }
        },
        "required": [
          "critical_failure_reason"
        ]
      },
      "then": {
        "properties": {
          "critical_failure": {
            "const": true
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/source-permission-grant.schema.json",
  "title": "SourcePermissionGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_id", "endpoint_ids", "status", "operations", "evidence_ids", "basis", "effective_from", "effective_until", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "source_id": {"$ref": "common.schema.json#/$defs/id"},
    "endpoint_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "status": {"enum": ["pending", "approved", "denied", "suspended", "revoked"]},
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "metadata", "excerpt_storage", "full_text_storage", "translation", "image_storage", "republication"],
      "properties": {
        "discovery": {"$ref": "#/$defs/operationPermission"},
        "metadata": {"$ref": "#/$defs/operationPermission"},
        "excerpt_storage": {"$ref": "#/$defs/operationPermission"},
        "full_text_storage": {"$ref": "#/$defs/operationPermission"},
        "translation": {"$ref": "#/$defs/operationPermission"},
        "image_storage": {"$ref": "#/$defs/operationPermission"},
        "republication": {"$ref": "#/$defs/operationPermission"}
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/id"}
    },
    "basis": {"type": "string", "minLength": 1, "maxLength": 2000},
    "effective_from": {"$ref": "common.schema.json#/$defs/dateTime"},
    "effective_until": {"$ref": "common.schema.json#/$defs/dateTime"},
    "created_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "reviewed_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 160},
    "revoked_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "revocation_reason": {"type": "string", "maxLength": 2000},
    "notes": {"type": "string", "maxLength": 4000}
  },
  "$defs": {
    "operationPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "status", "conditions"],
      "properties": {
        "allowed": {"type": "boolean"},
        "status": {"enum": ["pending", "approved", "denied", "suspended", "revoked"]},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/id"}}
      },
      "allOf": [
        {
          "if": {"properties": {"allowed": {"const": true}}, "required": ["allowed"]},
          "then": {"properties": {"status": {"const": "approved"}, "evidence_ids": {"minItems": 1}}, "required": ["evidence_ids"]}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {"required": ["reviewed_at", "reviewed_by"]}
    },
    {
      "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
      "then": {"required": ["revoked_at", "revocation_reason"]}
    }
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/timeline-event.schema.json",
  "title": "Timeline event assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "story_id",
    "title",
    "event_type",
    "occurred",
    "claim_ids",
    "created_at",
    "created_by",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "event_type": {
      "enum": [
        "announcement",
        "occurrence",
        "decision",
        "response",
        "impact",
        "legal_proceeding",
        "correction",
        "other"
      ]
    },
    "occurred": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision"
      ],
      "properties": {
        "precision": {
          "enum": [
            "instant",
            "date",
            "range",
            "approximate",
            "unknown"
          ]
        },
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "end": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "const": "instant"
              }
            }
          },
          "then": {
            "required": [
              "start"
            ],
            "properties": {
              "start": {
                "format": "date-time"
              }
            },
            "not": {
              "required": [
                "end"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "date"
              }
            }
          },
          "then": {
            "required": [
              "start"
            ],
            "properties": {
              "start": {
                "format": "date"
              }
            },
            "not": {
              "required": [
                "end"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "range"
              }
            }
          },
          "then": {
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "format": "date-time"
              },
              "end": {
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "approximate"
              }
            }
          },
          "then": {
            "required": [
              "start",
              "note"
            ],
            "properties": {
              "start": {
                "format": "date"
              }
            },
            "not": {
              "required": [
                "end"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "start"
                  ]
                },
                {
                  "required": [
                    "end"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "supersedes_event_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/timeline-event.schema.json",
  "title": "TimelineEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "story_id",
    "label",
    "time_precision",
    "claim_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "time_precision": {
      "enum": [
        "exact_instant",
        "date",
        "date_range",
        "approximate",
        "unknown"
      ]
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "occurred_on": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "start_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "end_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "start_on": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "end_on": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  }
}

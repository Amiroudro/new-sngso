{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/edition-artifact-manifest.schema.json",
  "title": "Immutable edition artifact provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "edition_id", "edition_revision", "edition_key", "created_at", "pipeline_run_id", "payload_sha256", "story_bindings", "source_permissions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/id"},
    "edition_id": {"$ref": "common.schema.json#/$defs/id"},
    "edition_revision": {"type": "integer", "minimum": 1},
    "edition_key": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([_-][a-z0-9-]+)?$"},
    "created_at": {"$ref": "common.schema.json#/$defs/dateTime"},
    "pipeline_run_id": {"$ref": "common.schema.json#/$defs/id"},
    "payload_sha256": {"$ref": "common.schema.json#/$defs/hash"},
    "story_bindings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["story_id", "story_revision", "story_snapshot_sha256", "learning_objects"],
        "properties": {
          "story_id": {"$ref": "common.schema.json#/$defs/id"},
          "story_revision": {"type": "integer", "minimum": 1},
          "story_snapshot_sha256": {"$ref": "common.schema.json#/$defs/hash"},
          "learning_objects": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["learning_object_id", "learning_object_revision", "learning_object_sha256", "kind", "language"],
              "properties": {
                "learning_object_id": {"$ref": "common.schema.json#/$defs/id"},
                "learning_object_revision": {"type": "integer", "minimum": 1},
                "learning_object_sha256": {"$ref": "common.schema.json#/$defs/hash"},
                "kind": {"enum": ["headline_summary", "brief_summary", "detailed_summary", "vocabulary", "comprehension_question", "analysis_question", "revision_card", "mcq_question"]},
                "language": {"enum": ["bn", "en"]}
              }
            },
            "allOf": [
              {"contains": {"type": "object", "properties": {"language": {"const": "bn"}}, "required": ["language"]}, "minContains": 1},
              {"contains": {"type": "object", "properties": {"language": {"const": "en"}}, "required": ["language"]}, "minContains": 1}
            ]
          }
        }
      }
    },
    "source_permissions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "endpoint_id", "grant_id", "operation"],
        "properties": {
          "source_id": {"$ref": "common.schema.json#/$defs/id"},
          "endpoint_id": {"$ref": "common.schema.json#/$defs/id"},
          "grant_id": {"$ref": "common.schema.json#/$defs/id"},
          "operation": {"const": "republication"}
        }
      }
    }
  }
}

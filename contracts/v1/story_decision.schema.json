{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/story_decision.schema.json",
  "title": "Story relationship decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "operation",
    "story_ids",
    "canonical_story_id",
    "article_ids",
    "decided_by",
    "rationale",
    "decided_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "operation": { "enum": ["merge", "split"] },
    "story_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "canonical_story_id": { "$ref": "common.schema.json#/$defs/id" },
    "article_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "decided_by": { "type": "string", "minLength": 1, "maxLength": 160 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "decided_at": { "$ref": "common.schema.json#/$defs/dateTime" }
  }
}

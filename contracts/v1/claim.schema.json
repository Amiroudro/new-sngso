{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "story_id",
    "text",
    "language",
    "assessment",
    "provenance",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "language": {
      "$ref": "common.schema.json#/$defs/languageTag"
    },
    "claim_type": {
      "enum": [
        "event",
        "quantity",
        "attribution",
        "causal",
        "legal",
        "forecast",
        "opinion",
        "other"
      ]
    },
    "assessment": {
      "enum": [
        "unassessed",
        "supported",
        "partially_supported",
        "disputed",
        "contradicted",
        "retracted"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/provenance"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "review_note": {
      "type": "string",
      "maxLength": 4000
    }
  }
}

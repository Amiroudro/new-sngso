{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarangsho.example/contracts/v1/editorial-benchmark-assignment.schema.json",
  "title": "Editorial benchmark review assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assignment_id",
    "artifact_id",
    "artifact_fingerprint",
    "language",
    "reviewer_id",
    "assigned_by",
    "assigned_at",
    "due_at",
    "status",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "artifact_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "language": {
      "enum": [
        "bn",
        "en"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "assigned_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "assigned",
        "accepted",
        "submitted",
        "cancelled",
        "expired"
      ]
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "closure_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "last_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "actor",
        "at",
        "reason"
      ],
      "properties": {
        "event": {
          "enum": [
            "accept",
            "submit",
            "cancel",
            "expire"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "accepted_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "submitted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "accepted_at",
          "submitted_review_id",
          "closed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "cancelled",
              "expired"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "closed_at",
          "closure_reason"
        ]
      }
    }
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/common.schema.json",
  "title": "Shared contract definitions",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9._~-]+$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri"
      ],
      "properties": {
        "uri": {
          "$ref": "#/$defs/uri"
        },
        "section": {
          "type": "string",
          "maxLength": 300
        },
        "paragraph_ref": {
          "type": "string",
          "maxLength": 160
        },
        "excerpt_ref": {
          "type": "string",
          "maxLength": 160
        },
        "accessed_at": {
          "$ref": "#/$defs/dateTime"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "observed_at",
        "method",
        "method_version"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "article_id": {
          "$ref": "#/$defs/id"
        },
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "observed_at": {
          "$ref": "#/$defs/dateTime"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "method_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "languageVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "status"
      ],
      "properties": {
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "status": {
          "enum": [
            "not_started",
            "draft",
            "review_required",
            "approved",
            "rejected"
          ]
        },
        "text": {
          "type": "string"
        },
        "review_note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}

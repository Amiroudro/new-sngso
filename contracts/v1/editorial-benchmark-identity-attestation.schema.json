{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarangsho.example/contracts/v1/editorial-benchmark-identity-attestation.schema.json",
  "title": "Provider-backed benchmark reviewer identity attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["attestation_id", "review_id", "review_revision", "principal_id", "issuer", "audience", "subject", "authenticated_at", "expires_at", "authentication_methods", "authentication_context", "provider_key_id", "provider_adapter", "session_fingerprint", "attested_at"],
  "properties": {
    "attestation_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "review_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "review_revision": {"type": "integer", "minimum": 1},
    "principal_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "issuer": {"type": "string", "format": "uri", "minLength": 1},
    "audience": {"type": "string", "minLength": 1, "maxLength": 500},
    "subject": {"type": "string", "minLength": 1, "maxLength": 500},
    "authenticated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authentication_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "authentication_context": {"type": "string", "minLength": 1, "maxLength": 500},
    "provider_key_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "provider_adapter": {"type": "string", "minLength": 1, "maxLength": 240},
    "session_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attested_at": {"type": "string", "format": "date-time"}
  }
}
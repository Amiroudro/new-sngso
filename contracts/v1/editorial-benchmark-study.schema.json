{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarangsho.example/contracts/v1/editorial-benchmark-study.schema.json",
  "title": "Editorial benchmark calibration study protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "study_version",
    "status",
    "benchmark_id",
    "benchmark_fingerprint",
    "rubric_version",
    "language_task_strata",
    "sampling_plan",
    "partition_membership",
    "reviewer_plan",
    "blind_assignment_plan",
    "analysis_plan",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "study_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "protocol_only"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "benchmark_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "language_task_strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "language",
          "task_type"
        ],
        "properties": {
          "language": {
            "enum": [
              "bn",
              "en"
            ]
          },
          "task_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "sampling_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampling_frame_description",
        "selection_method",
        "inclusion_criteria",
        "exclusion_criteria",
        "target_rationale"
      ],
      "properties": {
        "sampling_frame_description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 3000
        },
        "selection_method": {
          "enum": [
            "random",
            "stratified_random",
            "consecutive",
            "purposive",
            "census",
            "other"
          ]
        },
        "selection_method_detail": {
          "type": "string",
          "maxLength": 2000
        },
        "inclusion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        },
        "exclusion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          }
        },
        "target_rationale": {
          "type": "string",
          "minLength": 30,
          "maxLength": 3000
        }
      }
    },
    "partition_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_item_ids",
        "blind_evaluation_item_ids",
        "adjudication_item_ids"
      ],
      "properties": {
        "calibration_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "blind_evaluation_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "adjudication_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "reviewer_plan": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "principal_kind",
          "languages",
          "task_types",
          "training_completed",
          "qualification_basis"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "principal_kind": {
            "const": "human"
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "bn",
                "en"
              ]
            }
          },
          "task_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "training_completed": {
            "type": "boolean"
          },
          "training_record_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "qualification_basis": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          }
        }
      }
    },
    "blind_assignment_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "language",
          "task_type",
          "reviewer_ids"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "language": {
            "enum": [
              "bn",
              "en"
            ]
          },
          "task_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reviewer_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_scale",
        "proposed_statistic",
        "statistic_rationale",
        "unit_of_analysis",
        "confidence_interval_plan",
        "missing_data_plan",
        "independence_assumptions",
        "methodological_reviewer"
      ],
      "properties": {
        "measurement_scale": {
          "enum": [
            "nominal",
            "ordinal",
            "interval",
            "ratio"
          ]
        },
        "proposed_statistic": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "statistic_rationale": {
          "type": "string",
          "minLength": 30,
          "maxLength": 3000
        },
        "unit_of_analysis": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "confidence_interval_plan": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "missing_data_plan": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "independence_assumptions": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "methodological_reviewer": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 1000
      }
    }
  }
}

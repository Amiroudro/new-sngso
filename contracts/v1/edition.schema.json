{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/edition.schema.json",
  "title": "Edition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "edition_key",
    "created_at",
    "status",
    "content_hash",
    "pipeline_run_id",
    "story_ids",
    "language_variants"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "edition_key": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}([_-][a-z0-9-]+)?$"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "rejected",
        "superseded"
      ]
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "pipeline_run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "story_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "language_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/languageVariant"
      }
    },
    "supersedes_edition_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "correction_note": {
      "type": "string",
      "maxLength": 4000
    },
    "approved_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "published_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/learning-object.schema.json",
  "title": "LearningObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "story_id",
    "kind",
    "language",
    "status",
    "content",
    "claim_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "enum": [
        "headline_summary",
        "brief_summary",
        "detailed_summary",
        "vocabulary",
        "comprehension_question",
        "analysis_question",
        "revision_card",
        "mcq_question"
      ]
    },
    "language": {
      "$ref": "common.schema.json#/$defs/languageTag"
    },
    "status": {
      "enum": [
        "draft",
        "review_required",
        "approved",
        "rejected"
      ]
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "object",
          "null"
        ]
      },
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "claim_ids",
              "role"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "role": {
                "enum": [
                  "fact",
                  "attributed",
                  "analysis"
                ]
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "language_review"
                  ]
                },
                "then": {
                  "properties": {
                    "status": {
                      "const": "approved"
                    }
                  },
                  "required": [
                    "reviewed_at",
                    "reviewed_by",
                    "review_note"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "attributed"
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "then": {
                  "required": [
                    "attribution"
                  ]
                }
              }
            ]
          }
        },
        "answer_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "term_language": {
          "$ref": "common.schema.json#/$defs/languageTag"
        },
        "pronunciation": {
          "type": "string",
          "maxLength": 300
        },
        "part_of_speech": {
          "enum": [
            "noun",
            "verb",
            "adjective",
            "adverb",
            "preposition",
            "conjunction",
            "interjection",
            "phrase",
            "other"
          ]
        },
        "synonyms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "antonyms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "collocations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "exam_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "glossary_entry_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "correct_option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "distractor_rationales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option_id", "rationale", "basis_claim_ids"],
            "properties": {
              "option_id": {"type": "string", "minLength": 1, "maxLength": 40},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 1200},
              "basis_claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "common.schema.json#/$defs/id"}
              }
            }
          }
        },
        "difficulty": {
          "enum": [
            "easy",
            "moderate",
            "hard"
          ]
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "difficulty": {
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "review_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "variant_group_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "language_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "rubric_version",
        "reviewer_id",
        "reviewed_at",
        "dimensions",
        "note"
      ],
      "properties": {
        "language": {
          "enum": [
            "bn",
            "en"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewed_at": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grammar_and_spelling": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "naturalness_and_register": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "grammar_and_style": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "clarity_and_readability": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "terminology_consistency": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "factual_fidelity": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "attribution": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "omissions": {
              "enum": [
                "pass",
                "needs_revision"
              ]
            },
            "translation_fidelity": {
              "enum": [
                "pass",
                "needs_revision",
                "not_applicable"
              ]
            }
          }
        },
        "rubric_version": {
          "type": "string",
          "enum": [
            "bn-editorial-v1",
            "en-editorial-v1"
          ]
        },
        "identity_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal_id",
            "issuer",
            "subject",
            "provider_key_id",
            "provider_adapter",
            "authenticated_at",
            "attested_at",
            "authentication_methods",
            "authentication_context"
          ],
          "properties": {
            "principal_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "issuer": {
              "type": "string",
              "format": "uri"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "provider_key_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "provider_adapter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "authenticated_at": {
              "$ref": "common.schema.json#/$defs/dateTime"
            },
            "attested_at": {
              "$ref": "common.schema.json#/$defs/dateTime"
            },
            "authentication_methods": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "authentication_context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "language": {
                "const": "bn"
              }
            },
            "required": [
              "language"
            ]
          },
          "then": {
            "properties": {
              "rubric_version": {
                "const": "bn-editorial-v1"
              },
              "dimensions": {
                "required": [
                  "grammar_and_spelling",
                  "naturalness_and_register",
                  "terminology_consistency",
                  "factual_fidelity",
                  "attribution",
                  "omissions",
                  "translation_fidelity"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "language": {
                "const": "en"
              }
            },
            "required": [
              "language"
            ]
          },
          "then": {
            "properties": {
              "rubric_version": {
                "const": "en-editorial-v1"
              },
              "dimensions": {
                "required": [
                  "grammar_and_style",
                  "clarity_and_readability",
                  "terminology_consistency",
                  "factual_fidelity",
                  "attribution",
                  "omissions",
                  "translation_fidelity"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "headline_summary",
              "brief_summary",
              "detailed_summary",
              "revision_card"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "text",
              "segments"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "vocabulary"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "term",
              "term_language",
              "meaning",
              "context",
              "example",
              "part_of_speech",
              "glossary_entry_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "comprehension_question",
              "analysis_question"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "question",
              "answer",
              "explanation",
              "answer_claim_ids"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reviewed_at",
          "reviewed_by",
          "review_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "draft",
              "review_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reviewed_at"
              ]
            },
            {
              "required": [
                "reviewed_by"
              ]
            },
            {
              "required": [
                "review_note"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcq_question"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "question",
              "explanation",
              "answer_claim_ids",
              "options",
              "correct_option_id",
              "distractor_rationales"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "language_review"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected"
            ]
          }
        },
        "required": [
          "reviewed_at",
          "reviewed_by",
          "review_note"
        ]
      }
    }
  ]
}

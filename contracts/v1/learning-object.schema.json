{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/learning-object.schema.json",
  "title": "LearningObject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "story_id",
    "kind",
    "language",
    "status",
    "content",
    "claim_ids",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "story_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "enum": [
        "headline_summary",
        "brief_summary",
        "detailed_summary",
        "vocabulary",
        "comprehension_question",
        "analysis_question",
        "revision_card",
        "mcq_question"
      ]
    },
    "language": {
      "$ref": "common.schema.json#/$defs/languageTag"
    },
    "status": {
      "enum": [
        "draft",
        "review_required",
        "approved",
        "rejected"
      ]
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "array",
          "object",
          "null"
        ]
      },
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "example": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "claim_ids",
              "role"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 3000
              },
              "claim_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "role": {
                "enum": [
                  "fact",
                  "attributed",
                  "analysis"
                ]
              },
              "attribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "attributed"
                    }
                  },
                  "required": [
                    "role"
                  ]
                },
                "then": {
                  "required": [
                    "attribution"
                  ]
                }
              }
            ]
          }
        },
        "answer_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "term_language": {
          "$ref": "common.schema.json#/$defs/languageTag"
        },
        "pronunciation": {
          "type": "string",
          "maxLength": 300
        },
        "part_of_speech": {
          "enum": [
            "noun",
            "verb",
            "adjective",
            "adverb",
            "preposition",
            "conjunction",
            "interjection",
            "phrase",
            "other"
          ]
        },
        "synonyms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "antonyms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "collocations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "exam_context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "glossary_entry_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "correct_option_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "difficulty": {
          "enum": [
            "easy",
            "moderate",
            "hard"
          ]
        }
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "difficulty": {
      "enum": [
        "basic",
        "intermediate",
        "advanced"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "review_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "variant_group_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "headline_summary",
              "brief_summary",
              "detailed_summary",
              "revision_card"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "text",
              "segments"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "vocabulary"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "term",
              "term_language",
              "meaning",
              "context",
              "example",
              "part_of_speech",
              "glossary_entry_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "comprehension_question",
              "analysis_question"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "question",
              "answer",
              "explanation",
              "answer_claim_ids"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "reviewed_at",
          "reviewed_by",
          "review_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "draft",
              "review_required"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "reviewed_at"
              ]
            },
            {
              "required": [
                "reviewed_by"
              ]
            },
            {
              "required": [
                "review_note"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "mcq_question"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "required": [
              "question",
              "explanation",
              "answer_claim_ids",
              "options",
              "correct_option_id"
            ]
          }
        }
      }
    }
  ]
}

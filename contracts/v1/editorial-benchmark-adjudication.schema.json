{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarangsho.example/contracts/v1/editorial-benchmark-adjudication.schema.json",
  "title": "Editorial benchmark disagreement adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adjudication_id",
    "benchmark_id",
    "benchmark_fingerprint",
    "review_ids",
    "adjudicator",
    "outcome",
    "rationale",
    "evidence_references",
    "resolved_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "adjudication_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "benchmark_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "role",
        "qualification_basis",
        "independent_of_reviewers"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "const": "benchmark_adjudicator"
        },
        "qualification_basis": {
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "independent_of_reviewers": {
          "const": true
        }
      }
    },
    "outcome": {
      "enum": [
        "uphold_existing",
        "return_for_revision",
        "reject_benchmark_item",
        "split_accepted_answers"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 30,
      "maxLength": 5000
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    }
  }
}

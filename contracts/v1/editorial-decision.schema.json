{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/editorial-decision.schema.json",
  "title": "EditorialDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "subject_type",
    "subject_id",
    "decision",
    "reviewer_role",
    "rationale",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "subject_type": {
      "enum": [
        "claim",
        "perspective",
        "learning_object",
        "edition",
        "source_permission"
      ]
    },
    "subject_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "request_changes",
        "escalate",
        "revoke"
      ]
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewer_id": {
      "type": "string",
      "maxLength": 160
    },
    "policy_version": {
      "type": "string",
      "maxLength": 80
    },
    "supersedes_decision_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  }
}

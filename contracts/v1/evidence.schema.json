{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "claim_id",
    "source_id",
    "relationship",
    "locator",
    "assessed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "claim_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "article_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "observation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "relationship": {
      "enum": [
        "supports",
        "qualifies",
        "contradicts",
        "mentions",
        "unclear"
      ]
    },
    "assessment_method": {
      "enum": [
        "human",
        "rule",
        "model_assisted",
        "external_reference"
      ]
    },
    "assessment_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "locator": {
      "$ref": "common.schema.json#/$defs/locator"
    },
    "permitted_note": {
      "type": "string",
      "maxLength": 2000
    },
    "assessed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "assessed_by": {
      "type": "string",
      "maxLength": 160
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-sngso.local/contracts/v1/source-permission.schema.json",
  "title": "SourcePermission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "status",
    "operations",
    "basis",
    "effective_from",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "status": {
      "enum": [
        "approved",
        "pending",
        "denied",
        "expired",
        "revoked"
      ]
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "metadata",
        "excerpt_storage",
        "full_text_storage",
        "translation",
        "image_storage",
        "republication"
      ],
      "properties": {
        "discovery": {
          "$ref": "#/$defs/permission"
        },
        "metadata": {
          "$ref": "#/$defs/permission"
        },
        "excerpt_storage": {
          "$ref": "#/$defs/permission"
        },
        "full_text_storage": {
          "$ref": "#/$defs/permission"
        },
        "translation": {
          "$ref": "#/$defs/permission"
        },
        "image_storage": {
          "$ref": "#/$defs/permission"
        },
        "republication": {
          "$ref": "#/$defs/permission"
        }
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence_uri": {
      "$ref": "common.schema.json#/$defs/uri"
    },
    "effective_from": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "effective_until": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reviewed_by": {
      "type": "string",
      "maxLength": 160
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "status"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "denied",
            "expired",
            "revoked"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
